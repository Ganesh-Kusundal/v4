# Credentials — NEVER commit
.env.local
.env
*.env

# Python
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/
*.egg

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# runtime/ holds BOTH the tradex_runtime SOURCE package and local-only state
# written next to it (broker token_state.json with live access/refresh tokens,
# instrument-master dumps, workspace.sqlite, caches). Ignore the state, track
# the package. Do not widen this to /runtime/ — that would commit credentials.
# Tracked: runtime/pyproject.toml, runtime/src/, runtime/tests/
/runtime/*
!/runtime/pyproject.toml
!/runtime/src/
!/runtime/tests/

# Test artifacts
.pytest_cache/
htmlcov/
.coverage

# Tool caches & generated output
**/.mypy_cache/
.ruff_cache/
graphify-out/
.freebuff/
.kilo/
.benchmarks/
.complexipy_cache/
.hypothesis/
.poolside/
.workbuddy-ai/
logs/
$JCODE_SCRATCH_DIR/

# Typo duplicate of openalgo-charts/ (never commit)
referances/

# OS
.DS_Store
Thumbs.db

# Virtual envs
.venv/
venv/
# superpowers worktrees
.worktrees/

# superpowers scratch (ledger, task briefs)
.superpowers/

# Agent tool state
.commandcode/

# Market data store (281MB+ binary churn; rebuild via backfill_parquet.py)
data/ohlcv/

# Time-series model experiment scratch (single experiment home: poc/)
poc/*
!poc/README.md
!poc/research/
!poc/rank_0950.py
!poc/timesfm_0950.py
poc/data/*
!poc/data/build_0950_dataset.py

# Runtime state (tokens, instrument dumps; regenerate via broker connect)
trading/runtime/
trading/data/
backups/
data/logs/
data/backfill_2025.json

# Archify diagram build artifacts. The HTML deliverables and their JSON specs
# are tracked; the visual-check sidecars (screenshots, receipts, contact
# sheets) are regenerated by `visual-check` and are not source.
docs/diagrams/*.visual-check.*

# deploy/compose.yml bind-mounts this directory so container logs outlive the
# container. The artifacts in deploy/ are tracked; the output they produce is
# not, and without this an operator's first `up` shows a new untracked
# directory in `git status`.
deploy/logs/
